{
  "name": "learning-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "db:apply": "tsx --env-file-if-exists=.env.local scripts/db-apply.ts",
    "db:seed-dev": "tsx --env-file-if-exists=.env.local scripts/seed-dev.ts",
    "db:seed-throwaway": "tsx --env-file-if-exists=.env.local scripts/seed-throwaway.ts",
    "db:create-family": "tsx --env-file-if-exists=.env.local scripts/create-real-family.ts",
    "db:reset-password": "tsx --env-file-if-exists=.env.local scripts/reset-password.ts",
    "db:import-frame": "tsx --env-file-if-exists=.env.local scripts/import-frame.ts",
    "gen:config": "tsx scripts/gen-config-sql.ts",
    "doctor": "tsx --env-file-if-exists=.env.local scripts/doctor.ts",
    "storage:orphans": "tsx --env-file-if-exists=.env.local scripts/storage-orphans.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
