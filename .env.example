# Learning OS — biến môi trường (DESIGN §16). File mẫu: KHÔNG điền giá trị thật vào đây.
# Local: chép thành .env.local. Vercel: Project Settings → Environment Variables.

# --- Supabase (project dùng chung với Study Launcher, schema `english`) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ server (route handler). Không bao giờ đặt tiền tố NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Chỉ dùng cho script (npm run db:apply, db:seed-dev) và GitHub Actions — KHÔNG đặt trên Vercel.
# Supabase → Project Settings → Database → Connection string (Session pooler, port 5432).
DATABASE_URL=
# (tuỳ chọn) PEM CA của Supabase để xác minh chứng chỉ TLS khi chạy script.
DATABASE_CA_CERT=

# --- AI (lát S11–S12; để trống ở S0) ---
ANTHROPIC_API_KEY=
REVIEWER_MODEL=
COACH_MODEL=
AI_SOFT_CAP_USD=8
AI_MONTHLY_CAP_USD=10

# --- Vận hành ---
# Bí mật cho /api/jobs/sweep (lát S11).
CRON_SECRET=
# "true" mới hiện learner thật. Preview Vercel: luôn để false (chỉ learner thử).
ALLOW_REAL_LEARNERS=false
# Khoá CÔNG KHAI age (age1…) — chỉ dùng trong GitHub Actions backup. Khoá riêng phụ huynh giữ offline.
BACKUP_AGE_RECIPIENT=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Chỉ cho npm run db:seed-dev (tài khoản THỬ) ---
SEED_DEV_PASSWORD=
SEED_EMAIL_DOMAIN=example.com

# --- Chỉ cho test DB local (mặc định postgres://postgres:postgres@127.0.0.1:5432/postgres) ---
TEST_DATABASE_URL=
